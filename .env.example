# === Azure AI Foundry / Azure OpenAI ===
AZURE_AI_ENDPOINT=https://your-project.services.ai.azure.com
AZURE_AI_PROJECT=your-foundry-project
AZURE_AI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=gpt

# Model deployments
AZURE_AI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_AI_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_AI_VIDEO_DEPLOYMENT=sora-2

# === Azure AI Search ===
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX=enterprise-knowledge
AZURE_SEARCH_API_KEY=

# === Azure Blob Storage ===
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=enterprise-docs

# === Azure Cosmos DB ===
AZURE_COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=content-studio
AZURE_COSMOS_CHAT_CONTAINER=chat_records
AZURE_COSMOS_MEDIA_CONTAINER=media_records
AZURE_COSMOS_EVAL_CONTAINER=evaluation_records
AZURE_COSMOS_AUTH_CONTAINER=auth_records

# === Azure Cache for Redis ===
AZURE_REDIS_HOST=your-redis.redis.cache.windows.net
AZURE_REDIS_PORT=6380
AZURE_REDIS_KEY=
REDIS_CACHE_TTL_SECONDS=600

# === PostgreSQL (operational + RAG telemetry) ===
POSTGRES_DSN=postgresql://postgres:password@your-pg-server.postgres.database.azure.com:5432/contentstudio?sslmode=require

# === Observability ===
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=enterprise-genai-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# === Governance ===
PII_DETECTION_ENABLED=true
CONTENT_SAFETY_ENABLED=true
AUDIT_LOG_PATH=./logs/audit.jsonl
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-content-safety.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=
GDPR_DATA_RETENTION_DAYS=90
GDPR_RIGHT_TO_ERASURE=true

# === Evaluation ===
EVAL_ENABLED=true
EVAL_SAMPLE_RATE=0.1

# === Cost Control / Idle Auto-Stop ===
AUTO_STOP_ENABLED=false
AUTO_STOP_MODE=soft
AUTO_STOP_ALLOW_HARD_SHUTDOWN=false
AUTO_STOP_IDLE_MINUTES=90
AUTO_STOP_CHECK_INTERVAL_SECONDS=120
# Demo day protection (monthly day numbers). Example: keep service awake on day 20.
AUTO_STOP_SKIP_DAYS=20
AUTO_STOP_IGNORE_PATHS=/health,/docs,/openapi.json,/internal,/
# Required only when AUTO_STOP_MODE=hard
AUTO_STOP_SUBSCRIPTION_ID=
AUTO_STOP_RESOURCE_GROUP=
AUTO_STOP_WEBAPP_NAME=
